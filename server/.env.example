PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (leave empty or use memory server if local MongoDB is not installed)
MONGODB_URI=mongodb://127.0.0.1:27017/mylife_calendar
USE_IN_MEMORY_DB=true

# JWT Secret
JWT_SECRET=mylife_calendar_super_secret_jwt_key_2026_dev_mode
JWT_EXPIRES_IN=30d

# OTP Configuration
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=5
DEV_MODE_OTP=123456
SMS_PROVIDER=mock
