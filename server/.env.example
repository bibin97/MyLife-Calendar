PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Production: set the exact HTTPS Vercel origin. Browser calls same-origin /api.
# CLIENT_ORIGIN=https://your-app.vercel.app
# Optional extra HTTPS origins (comma-separated). Localhost entries are ignored in production.
# FRONTEND_ORIGINS=

# MongoDB Community Server (leave USE_IN_MEMORY_DB=false for local Community)
MONGODB_URI=mongodb://127.0.0.1:27017/mylife_calendar
USE_IN_MEMORY_DB=false

# JWT Secret — required unique value (>= 32 chars) when NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Same-origin /api uses Lax. Set none only if the browser calls a different API host.
COOKIE_SAMESITE=lax

# OTP Configuration
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=5
DEV_MODE_OTP=123456
SMS_PROVIDER=mock
